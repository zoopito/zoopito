<!DOCTYPE html>
<html lang="en" >
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>Zoopito</title>

  <!-- Primary Meta Tags -->
  <meta name="title" content="Zoopito" />
  <meta name="description" content="Zoopito is a platform for managing veterinary and sales teams." />
  <meta name="keywords" content="zoopito, veterinary, sales, team management" />
  <meta name="author" content="Saurabh Mishra" />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://zoopito.in/" />
  <meta property="og:title" content="Zoopito - Veterinary & Sales Team Management Platform" />
  <meta property="og:description" content="Zoopito is a platform for managing veterinary and sales teams." />
  <meta property="og:image" content="https://zoopito.in/images/favicon-32x32.png" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://zoopito.in/" />
  <meta property="twitter:title" content="Zoopito - Veterinary & Sales Team Management Platform" />
  <meta property="twitter:description" content="Zoopito is a platform for managing veterinary and sales teams." />
  <meta property="twitter:image" content="https://zoopito.com/images/zoopito-og.png" />

  <!-- WhatsApp / LinkedIn (uses OG tags automatically) -->
  <meta property="og:site_name" content="Zoopito" />

  <!-- Favicons -->
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
  <link rel="manifest" href="/images/site.webmanifest" />
  <link rel="mask-icon" href="/images/safari-pinned-tab.svg" color="#10b981" />
  <meta name="msapplication-TileColor" content="#10b981" />
  <meta name="theme-color" content="#10b981" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin " />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;400;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- AOS -->
  <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/output.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Smooth Theme Transition -->
  <style>
    html, body {
      transition: background-color 0.25s, color 0.25s;
    }
    
    /* RESTORED: Dynamic Vector Running Light Animation Styles */
    .global-lightning-track {
        stroke-dasharray: 2000;
        stroke-dashoffset: 2000;
        animation: globalTrackPulse 12s infinite linear;
    }
    .line-fast { animation-duration: 9s; }
    .line-slow { animation-duration: 16s; direction: reverse; }

    @keyframes globalTrackPulse {
        0% { stroke-dashoffset: 2000; opacity: 0.1; }
        50% { opacity: 0.85; }
        100% { stroke-dashoffset: 0; opacity: 0.1; }
    }
  </style>

  <!-- Dark mode detection -->
  <script>
    if (localStorage.theme === "dark") {
      document.documentElement.classList.add("dark");
    }
  </script>
</head>

<body class="bg-gray-50 font-sans text-gray-800 dark:bg-black relative min-h-screen">

  <% if(showsplash){ %>
  <!-- Splash Screen -->
    <div id="splash">
        <div class="particles" id="particles"></div>
        
        <div class="splash-content">
            <div class="logo-container">
                <div class="logo-ring"></div>
                <img src="images/logo2.png" class="logo" alt="Zoopito Logo" />
            </div>
            
            <div class="loading-bar">
                <div class="loading-progress"></div>
            </div>
            
            <div class="loading-text">Loading Zoopito...</div>
        </div>
    </div>
  <% } %>

  <style>
    body {
        position: relative;
        min-height: 100vh;
    }
    #global-hybrid-3d-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -10;
        pointer-events: none;
    }
    /* Fixed Light Mode blend visibility logic */
    .canvas-adaptive-blend { mix-blend-mode: normal; opacity: 0.55; }
    .dark .canvas-adaptive-blend { mix-blend-mode: screen; opacity: 0.9; }
  </style>

  <!-- ADDED BACK: Glowing Lighting Vector Tracks behind components -->
  <div class="fixed inset-0 z-[-15] pointer-events-none overflow-hidden opacity-70 dark:opacity-35">
        <svg class="w-full h-full" viewBox="0 0 1440 800" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <filter id="global-super-glow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="10" result="blur" />
                    <feMerge>
                        <feMergeNode in="blur" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
                <linearGradient id="global-cyber-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#38BDF8" />
                    <stop offset="100%" stop-color="#22C55E" />
                </linearGradient>
            </defs>
            <path class="global-lightning-track line-fast" d="M -100,250 Q 400,80 800,450 T 1600,250" stroke="url(#global-cyber-grad)" stroke-width="2.5" fill="none" filter="url(#global-super-glow)" />
            <path class="global-lightning-track line-slow" d="M 0,550 Q 450,700 850,350 T 1550,650" stroke="#38BDF8" stroke-width="1.5" fill="none" opacity="0.6" filter="url(#global-super-glow)" />
        </svg>
  </div>

  <!-- Main 3D Particle Element Container -->
  <div id="global-hybrid-3d-canvas" class="canvas-adaptive-blend"></div>

  <!-- Navbar -->
  <%- include("../includes/navbar.ejs") %>

  <!-- Flash Messages -->
  <div class="w-full mx-auto" style="min-height: 100vh !important;">
    <%- include("../includes/flash.ejs") %>
    <%- body %>
  </div>

  <!-- Footer -->
  <%- include("../includes/footer.ejs") %>

  <!-- AOS -->
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script>AOS.init();</script>

  <!-- App Script -->
  <script src="/js/script.js"></script>

  <!-- Zoopito AI Chat Support -->
  <script>
    window.ZOOPITO_USER_ROLE = '<%= typeof currUser !== "undefined" && currUser ? currUser.role : "GUEST" %>';
    window.ZOOPITO_USER_NAME = '<%= typeof currUser !== "undefined" && currUser ? (currUser.name || currUser.username || "there") : "there" %>';
  </script>
  <script src="/js/chat-support.js" defer></script>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        window.Swal = Swal;
    </script>
    
    <%= typeof pageScripts !== 'undefined' ? pageScripts : '' %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
    // RESTORED: Original 3D Engine Setup with exact logic
    const container = document.getElementById('global-hybrid-3d-canvas');
    if (container) {
        const scene = new THREE.Scene();
        
        const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.z = 7;
        
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        const isDark = document.documentElement.classList.contains('dark');
        
        // Original Matrix Nodes Layer
        const particleGeometry = new THREE.BufferGeometry();
        const particleCount = 200; 
        const coords = new Float32Array(particleCount * 3);

        for(let i = 0; i < particleCount * 3; i += 3) {
            coords[i] = (Math.random() - 0.5) * 18;
            coords[i+1] = (Math.random() - 0.5) * 14;  
            coords[i+2] = (Math.random() - 0.5) * 6;
        }
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(coords, 3));

        const particleMaterial = new THREE.PointsMaterial({
            color: 0x38BDF8,
            size: 0.12,
            transparent: true,
            opacity: isDark ? 0.7 : 0.5
        });
        const networkMesh = new THREE.Points(particleGeometry, particleMaterial);
        scene.add(networkMesh);

        // Original 3D Spatial Systems (Torus 1 & Torus 2)
        const orbitGroup = new THREE.Group();
        
        const torus1Geo = new THREE.TorusGeometry(3.5, 0.04, 16, 100);
        const torus1Mat = new THREE.MeshBasicMaterial({ color: 0x22C55E, transparent: true, opacity: isDark ? 0.2 : 0.35 });
        const torus1 = new THREE.Mesh(torus1Geo, torus1Mat);
        torus1.rotation.x = Math.PI / 3;
        orbitGroup.add(torus1);

        const torus2Geo = new THREE.TorusGeometry(4.8, 0.02, 12, 80);
        const torus2Mat = new THREE.MeshBasicMaterial({ color: 0x38BDF8, transparent: true, opacity: isDark ? 0.15 : 0.3 });
        const torus2 = new THREE.Mesh(torus2Geo, torus2Mat);
        torus2.rotation.y = Math.PI / 4;
        orbitGroup.add(torus2);

        scene.add(orbitGroup);

        // Interaction
        let mouseX = 0, mouseY = 0;
        window.addEventListener('mousemove', (e) => {
            mouseX = (e.clientX / window.innerWidth) - 0.5;
            mouseY = (e.clientY / window.innerHeight) - 0.5;
        });

        function renderingEngine() {
            requestAnimationFrame(renderingEngine);
            
            networkMesh.rotation.y += 0.0008;
            networkMesh.rotation.x += 0.0004;
            torus1.rotation.x += 0.0006;
            torus2.rotation.y -= 0.0005;

            camera.position.x += (mouseX * 3 - camera.position.x) * 0.05;
            camera.position.y += (-mouseY * 3 - camera.position.y) * 0.05;
            camera.lookAt(scene.position);

            renderer.render(scene, camera);
        }
        renderingEngine();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // Theme Toggle Observer
        const themeObserver = new MutationObserver(() => {
            const updatedDark = document.documentElement.classList.contains('dark');
            particleMaterial.opacity = updatedDark ? 0.7 : 0.5;
            torus1Mat.opacity = updatedDark ? 0.2 : 0.35;
            torus2Mat.opacity = updatedDark ? 0.15 : 0.3;
        });
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    }
</script>
</body>
</html>