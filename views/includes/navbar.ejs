<!-- BACKDROP FOR MOBILE MENU -->
<div id="mobileBackdrop" 
     class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity"></div>

<script>
  // ============================================================
  // 1. DARK MODE - PERSISTENT & SYSTEM DETECTION
  // ============================================================
  
  // Check if system is in dark mode
  function isSystemDark() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  // Get stored theme preference
  function getStoredTheme() {
    return localStorage.getItem('zoopito-theme') || localStorage.getItem('theme');
  }

  // Set theme and store preference
  function setTheme(theme) {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
      localStorage.setItem('zoopito-theme', 'dark');
      localStorage.removeItem('theme');
    } else if (theme === 'light') {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('zoopito-theme', 'light');
      localStorage.removeItem('theme');
    } else {
      // Fallback: follow system
      if (isSystemDark()) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      localStorage.removeItem('zoopito-theme');
      localStorage.removeItem('theme');
    }
    updateThemeIcons();
    updateToggleVisibility();
  }

  // Update theme icons based on current state
  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const themeIcon = document.getElementById('themeIcon');
    const mobileThemeIcon = document.getElementById('mobileThemeIcon');
    
    if (isDark) {
      if (themeIcon) themeIcon.className = 'fas fa-sun text-sm';
      if (mobileThemeIcon) mobileThemeIcon.className = 'fas fa-sun text-yellow-400';
    } else {
      if (themeIcon) themeIcon.className = 'fas fa-moon text-sm';
      if (mobileThemeIcon) mobileThemeIcon.className = 'fas fa-moon text-sky-500';
    }
  }

  // Show/hide toggle buttons based on system dark mode
  function updateToggleVisibility() {
    // The toggle must remain available even when the system prefers dark.
    // A user can explicitly switch to light or dark at any time.
    const desktopToggle = document.getElementById('themeToggle');
    const mobileToggle = document.getElementById('mobileThemeToggle');
    if (desktopToggle) desktopToggle.classList.remove('hidden-toggle');
    if (mobileToggle) mobileToggle.classList.remove('hidden-toggle');
  }

  // Initialize theme on page load
  function initializeTheme() {
    const storedTheme = getStoredTheme();
    const systemDark = isSystemDark();
    
    console.log('🔍 Initializing theme...');
    console.log('  - Stored theme:', storedTheme);
    console.log('  - System dark:', systemDark);
    
    // Case 1: User has stored preference
    if (storedTheme === 'dark') {
      console.log('  → Applying stored DARK theme');
      document.documentElement.classList.add('dark');
      localStorage.setItem('zoopito-theme', 'dark');
    } else if (storedTheme === 'light') {
      console.log('  → Applying stored LIGHT theme');
      document.documentElement.classList.remove('dark');
      localStorage.setItem('zoopito-theme', 'light');
    } else {
      // Case 2: No stored preference - follow system
      console.log('  → No stored preference, following system');
      if (systemDark) {
        document.documentElement.classList.add('dark');
        localStorage.removeItem('zoopito-theme');
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.removeItem('zoopito-theme');
      }
    }
    
    updateThemeIcons();
    updateToggleVisibility();
    console.log('  → Final theme:', document.documentElement.classList.contains('dark') ? 'DARK' : 'LIGHT');
  }

  // Toggle theme function
  function toggleTheme() {
    const currentIsDark = document.documentElement.classList.contains('dark');
    if (currentIsDark) {
      setTheme('light');
    } else {
      setTheme('dark');
    }
    // Re-check toggle visibility after manual toggle
    updateToggleVisibility();
  }

  // Keep the system-following theme in sync until the user chooses a mode.
  const systemThemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
  const handleSystemThemeChange = event => {
    if (!getStoredTheme()) {
      document.documentElement.classList.toggle('dark', event.matches);
      updateThemeIcons();
      updateToggleVisibility();
    }
  };
  if (systemThemeQuery.addEventListener) {
    systemThemeQuery.addEventListener('change', handleSystemThemeChange);
  } else {
    systemThemeQuery.addListener(handleSystemThemeChange);
  }

  // ============================================================
  // 2. EVENT LISTENERS
  // ============================================================

  // 🔥 FIX: Run immediately when script loads (before DOM ready)
  // This prevents flash of wrong theme
  (function init() {
    // Check if we have a stored theme
    const storedTheme = localStorage.getItem('zoopito-theme');
    
    if (storedTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else if (storedTheme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      // No stored preference - follow system
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
  })();

  // Full initialization on DOM ready
  document.addEventListener('DOMContentLoaded', function() {
    initializeTheme();
  });

  // Also run if DOM already loaded
  if (document.readyState !== 'loading') {
    initializeTheme();
  }

  // Theme toggle buttons
  const themeToggle = document.getElementById('themeToggle');
  const mobileThemeToggle = document.getElementById('mobileThemeToggle');

  themeToggle?.addEventListener('click', toggleTheme);
  mobileThemeToggle?.addEventListener('click', toggleTheme);

  // ============================================================
  // 3. MOBILE MENU TOGGLE
  // ============================================================
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenuClose = document.getElementById('mobileMenuClose');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileBackdrop = document.getElementById('mobileBackdrop');

  function openMobileMenu() {
    mobileMenu.classList.remove('translate-x-full');
    mobileBackdrop.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    mobileMenu.classList.add('translate-x-full');
    mobileBackdrop.classList.add('hidden');
    document.body.style.overflow = '';
  }

  mobileMenuBtn?.addEventListener('click', openMobileMenu);
  mobileMenuClose?.addEventListener('click', closeMobileMenu);
  mobileBackdrop?.addEventListener('click', closeMobileMenu);

  // ============================================================
  // 4. USER DROPDOWN
  // ============================================================
  const currUserMenuBtn = document.getElementById('currUserMenuBtn');
  const currUserDropdown = document.getElementById('currUserDropdown');
  
  if (currUserMenuBtn && currUserDropdown) {
    currUserMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      currUserDropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!currUserMenuBtn.contains(e.target) && !currUserDropdown.contains(e.target)) {
        currUserDropdown.classList.add('hidden');
      }
    });
  }

  // ============================================================
  // 5. CLOSE ON ESCAPE
  // ============================================================
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      currUserDropdown?.classList.add('hidden');
      closeMobileMenu();
    }
  });
</script>