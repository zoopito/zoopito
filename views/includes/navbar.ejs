<style>
  .zoopito-logo {
    filter:
      drop-shadow(0 0 6px rgba(56, 189, 248, 0.7))
      drop-shadow(0 0 12px rgba(34, 197, 94, 0.4));
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dark .zoopito-logo {
    filter:
      drop-shadow(0 0 8px rgba(34, 197, 94, 0.8))
      drop-shadow(0 0 18px rgba(56, 189, 248, 0.5));
  }

  .zoopito-logo:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  .nav-link-hover {
    position: relative;
  }

  .nav-link-hover::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #38BDF8, #22C55E);
    transition: width 0.3s ease;
  }

  .nav-link-hover:hover::after {
    width: 100%;
  }

  /* Theme toggle button */
  .theme-toggle-btn {
    background: linear-gradient(135deg, #38BDF8, #22C55E);
    color: white;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    display: inline-flex;
  }

  .theme-toggle-btn:hover {
    transform: rotate(15deg) scale(1.1);
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
  }

  .dark .theme-toggle-btn {
    background: linear-gradient(135deg, #f59e0b, #f97316);
  }

  .dark .theme-toggle-btn:hover {
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.4);
  }

  /* Hide toggle when system is dark */
  .theme-toggle-btn.hidden-toggle {
    display: none !important;
  }

  .notification-badge {
    background: linear-gradient(135deg, #FF6B6B, #FF8E53);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .currUser-avatar {
    background: linear-gradient(135deg, #38BDF8, #22C55E);
    transition: transform 0.3s ease;
  }

  .currUser-avatar:hover {
    transform: scale(1.1);
  }

  /* Mobile menu link active state */
  .mobile-link-active {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(34, 197, 94, 0.1));
    color: #2563eb;
    border-left: 4px solid #38BDF8;
  }

  .dark .mobile-link-active {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(34, 197, 94, 0.05));
    color: #60a5fa;
    border-left-color: #60a5fa;
  }

  .mobile-link {
    transition: all 0.2s ease;
  }

  .mobile-link:hover {
    background: rgba(56, 189, 248, 0.05);
    transform: translateX(4px);
  }

  .dark .mobile-link:hover {
    background: rgba(56, 189, 248, 0.08);
  }

  /* Mobile menu sections */
  .mobile-section-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #9ca3af;
    padding: 8px 16px 4px;
    font-weight: 600;
  }

  .dark .mobile-section-title {
    color: #6b7280;
  }

  .mobile-divider {
    border-top: 1px solid #e5e7eb;
    margin: 8px 16px;
  }

  .dark .mobile-divider {
    border-top-color: #374151;
  }
</style>

