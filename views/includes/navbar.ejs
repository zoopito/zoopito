                  class="theme-toggle-btn flex items-center gap-3 px-4 py-2.5 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
            <i id="mobileThemeIcon" class="fas fa-moon text-sky-500"></i>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Dark Mode</span>
          </button>
          
