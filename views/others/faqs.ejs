<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ============================================================
        // 1. FAQ CARD TOGGLE
        // ============================================================
        const faqCards = document.querySelectorAll('.faq-card');
        
        faqCards.forEach(card => {
            card.addEventListener('click', function(e) {
                // Don't toggle if clicking on a link
                if (e.target.closest('a')) return;
                
                const isOpen = this.classList.contains('open');
                
                // Close all cards
                faqCards.forEach(c => c.classList.remove('open'));
                
                // Open clicked card if it wasn't open
                if (!isOpen) {
                    this.classList.add('open');
                }
            });
        });

        // ============================================================
        // 2. CATEGORY FILTER
        // ============================================================
        const categoryTabs = document.querySelectorAll('.category-tab');
        const allCards = document.querySelectorAll('.faq-card');
        const noResults = document.getElementById('noResults');
        
        let activeCategory = 'all';
        
        categoryTabs.forEach(tab => {
            tab.addEventListener('click', function() {
                // Update active tab
                categoryTabs.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                
                activeCategory = this.dataset.category;
                
                // Apply filter
                filterFAQs();
            });
        });

        function filterFAQs() {
            const searchTerm = document.getElementById('faqSearch').value.toLowerCase().trim();
            let visibleCount = 0;
            
            allCards.forEach(card => {
                const category = card.dataset.category;
                const searchData = card.dataset.search || '';
                const text = card.textContent.toLowerCase();
                
                const matchesCategory = activeCategory === 'all' || category === activeCategory;
                const matchesSearch = !searchTerm || 
                    text.includes(searchTerm) || 
                    searchData.includes(searchTerm);
                
                if (matchesCategory && matchesSearch) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Show/hide no results
            if (visibleCount === 0) {
                noResults.classList.add('visible');
            } else {
                noResults.classList.remove('visible');
            }
        }

        // ============================================================
        // 3. SEARCH FUNCTIONALITY
        // ============================================================
        const searchInput = document.getElementById('faqSearch');
        const searchClear = document.getElementById('searchClear');
        
        searchInput.addEventListener('input', function() {
            const hasText = this.value.length > 0;
            searchClear.classList.toggle('visible', hasText);
            
            // Reset to "All" category when searching
            if (hasText) {
                categoryTabs.forEach(t => t.classList.remove('active'));
                document.querySelector('.category-tab[data-category="all"]').classList.add('active');
                activeCategory = 'all';
            }
            
            filterFAQs();
        });
        
        searchClear.addEventListener('click', function() {
            resetSearch();
        });

        function resetSearch() {
            searchInput.value = '';
            searchClear.classList.remove('visible');
            
            // Reset to "All" category
            categoryTabs.forEach(t => t.classList.remove('active'));
            document.querySelector('.category-tab[data-category="all"]').classList.add('active');
            activeCategory = 'all';
            
            filterFAQs();
            
            // Scroll to top of FAQ section
            document.querySelector('#faqGrid').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        // ============================================================
        // 4. KEYBOARD SHORTCUT: ESC to reset
        // ============================================================
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                resetSearch();
                // Close all open cards
                faqCards.forEach(c => c.classList.remove('open'));
            }
        });

        // ============================================================
        // 5. SMOOTH SCROLL FOR HASH LINKS
        // ============================================================
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href !== '#') {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                }
            });
        });
    });
</script>