<!-- How to Apply - Email Option -->
<section id="apply" class="py-16 bg-gray-50 dark:bg-gray-900/50">
    <div class="container mx-auto px-4 md:px-8">
        <div class="max-w-3xl mx-auto">
            <div class="text-center mb-10">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
                    How to Apply
                </h2>
                <p class="text-gray-600 dark:text-gray-400">
                    We'd love to hear from you! Send us your resume and a brief introduction.
                </p>
            </div>
            
            <!-- Email Card -->
            <div class="email-card rounded-2xl p-8 md:p-10 text-center">
                <div class="w-20 h-20 bg-gradient-to-r from-blue-500 to-green-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-envelope text-white text-3xl"></i>
                </div>
                
                <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white mb-3">
                    Send Your Resume via Email
                </h3>
                
                <p class="text-gray-600 dark:text-gray-400 mb-6">
                    Forward your resume along with a brief cover letter or introduction to:
                </p>
                
                <div class="bg-white dark:bg-gray-800 rounded-xl p-4 md:p-5 inline-flex items-center gap-4 shadow-md border border-gray-200 dark:border-gray-700">
                    <i class="fas fa-envelope-open-text text-blue-500 text-xl"></i>
                    <span class="text-xl font-semibold text-gray-900 dark:text-white select-all">careers@zoopito.in</span>
                    <button onclick="copyEmail()" class="copy-btn px-4 py-2 bg-gradient-to-r from-blue-500 to-green-500 text-white rounded-lg text-sm font-medium hover:shadow-lg transition-all duration-300">
                        <i class="fas fa-copy mr-1"></i>
                        Copy
                    </button>
                </div>
                
                <div class="mt-6 text-sm text-gray-500 dark:text-gray-400">
                    <p class="flex items-center justify-center gap-2">
                        <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                        We review every application
                    </p>
                    <p class="flex items-center justify-center gap-2 mt-1">
                        <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
                        Response within 5-7 business days
                    </p>
                </div>
            </div>
            
            <!-- Tips Section -->
            <div class="mt-8 grid sm:grid-cols-2 gap-4">
                <div class="bg-white dark:bg-gray-800 rounded-xl p-5 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center">
                            <i class="fas fa-file-pdf text-blue-600 dark:text-blue-400"></i>
                        </div>
                        <h4 class="font-semibold text-gray-900 dark:text-white">Resume Format</h4>
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        PDF, DOCX, or DOC format preferred. Keep it under 5MB.
                    </p>
                </div>
                
                <div class="bg-white dark:bg-gray-800 rounded-xl p-5 border border-gray-200 dark:border-gray-700">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
                            <i class="fas fa-pen-fancy text-green-600 dark:text-green-400"></i>
                        </div>
                        <h4 class="font-semibold text-gray-900 dark:text-white">Cover Letter</h4>
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Tell us why you're interested in Zoopito and what you can bring to the team.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
