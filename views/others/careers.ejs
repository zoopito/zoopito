<% layout("/layouts/boilerplate") -%>

<style>
    .career-hero {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.12) 0%, rgba(34, 197, 94, 0.12) 100%);
        border-bottom: 1px solid rgba(56, 189, 248, 0.1);
    }
    
    .career-card {
        transition: all 0.3s ease;
        border: 1px solid #e5e7eb;
        cursor: pointer;
    }
    
    .career-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        border-color: #38BDF8;
    }
    
    .dark .career-card {
        border-color: #374151;
    }
    
    .dark .career-card:hover {
        border-color: #38BDF8;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }
    
    .career-card .icon-wrapper {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    
    .career-card .icon-wrapper.blue {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(56, 189, 248, 0.05));
        color: #38BDF8;
    }
    
    .career-card .icon-wrapper.green {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), rgba(34, 197, 94, 0.05));
        color: #22C55E;
    }
    
    .career-card .icon-wrapper.purple {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(168, 85, 247, 0.05));
        color: #A855F7;
    }
    
    .career-card .icon-wrapper.orange {
        background: linear-gradient(135deg, rgba(251, 146, 60, 0.15), rgba(251, 146, 60, 0.05));
        color: #FB923C;
    }
    
    .career-card .icon-wrapper.pink {
        background: linear-gradient(135deg, rgba(244, 63, 94, 0.15), rgba(244, 63, 94, 0.05));
        color: #F43F5E;
    }
    
    .career-card .icon-wrapper.teal {
        background: linear-gradient(135deg, rgba(20, 184, 166, 0.15), rgba(20, 184, 166, 0.05));
        color: #14B8A6;
    }
    
    .dark .career-card .icon-wrapper.blue {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(56, 189, 248, 0.05));
    }
    
    .dark .career-card .icon-wrapper.green {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(34, 197, 94, 0.05));
    }
    
    .dark .career-card .icon-wrapper.purple {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(168, 85, 247, 0.05));
    }
    
    .tag {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 12px;
        font-weight: 500;
    }
    
    .tag.full-time {
        background: rgba(56, 189, 248, 0.15);
        color: #38BDF8;
    }
    
    .tag.part-time {
        background: rgba(34, 197, 94, 0.15);
        color: #22C55E;
    }
    
    .tag.contract {
        background: rgba(251, 146, 60, 0.15);
        color: #FB923C;
    }
    
    .tag.internship {
        background: rgba(168, 85, 247, 0.15);
        color: #A855F7;
    }
    
    .tag.remote {
        background: rgba(20, 184, 166, 0.15);
        color: #14B8A6;
    }
    
    .dark .tag.full-time {
        background: rgba(56, 189, 248, 0.2);
    }
    
    .dark .tag.part-time {
        background: rgba(34, 197, 94, 0.2);
    }
    
    .dark .tag.contract {
        background: rgba(251, 146, 60, 0.2);
    }
    
    .dark .tag.internship {
        background: rgba(168, 85, 247, 0.2);
    }
    
    .dark .tag.remote {
        background: rgba(20, 184, 166, 0.2);
    }
    
    .benefit-item {
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }
    
    .benefit-item:hover {
        border-color: #e5e7eb;
        background: rgba(56, 189, 248, 0.03);
    }
    
    .dark .benefit-item:hover {
        border-color: #374151;
        background: rgba(56, 189, 248, 0.05);
    }
    
    .email-card {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.05), rgba(34, 197, 94, 0.05));
        border: 2px dashed rgba(56, 189, 248, 0.3);
        transition: all 0.3s ease;
    }
    
    .email-card:hover {
        border-color: #38BDF8;
        box-shadow: 0 8px 30px rgba(56, 189, 248, 0.1);
    }
    
    .dark .email-card {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.03), rgba(34, 197, 94, 0.03));
        border-color: rgba(56, 189, 248, 0.15);
    }
    
    .dark .email-card:hover {
        border-color: #38BDF8;
        box-shadow: 0 8px 30px rgba(56, 189, 248, 0.05);
    }
    
    .copy-btn {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .copy-btn:hover {
        transform: scale(1.05);
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animate-on-scroll {
        opacity: 0;
        animation: fadeInUp 0.6s ease forwards;
    }
    
    .animate-on-scroll:nth-child(1) { animation-delay: 0.1s; }
    .animate-on-scroll:nth-child(2) { animation-delay: 0.2s; }
    .animate-on-scroll:nth-child(3) { animation-delay: 0.3s; }
    .animate-on-scroll:nth-child(4) { animation-delay: 0.4s; }
    .animate-on-scroll:nth-child(5) { animation-delay: 0.5s; }
    .animate-on-scroll:nth-child(6) { animation-delay: 0.6s; }
    
    .animate-on-scroll.visible {
        opacity: 1;
        animation: fadeInUp 0.6s ease forwards;
    }
    
    @media (max-width: 640px) {
        .career-card .icon-wrapper {
            width: 44px;
            height: 44px;
            font-size: 18px;
        }
    }
</style>

<!-- Hero Section -->
<section class="career-hero py-16 md:py-24">
    <div class="container mx-auto px-4 md:px-8">
        <div class="text-center max-w-4xl mx-auto">
            <div class="inline-flex items-center px-4 py-2 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 mb-6">
                <i class="fas fa-briefcase mr-2"></i>
                <span class="text-sm font-medium">Join Our Team</span>
            </div>
            
            <h1 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
                Build the Future of
                <span class="bg-gradient-to-r from-blue-500 to-green-500 bg-clip-text text-transparent">
                    Livestock Intelligence
                </span>
            </h1>
            
            <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 mb-8 max-w-3xl mx-auto leading-relaxed">
                Join us in transforming livestock management across India. We're looking for passionate individuals 
                who want to make a difference in rural communities through technology.
            </p>
            
            <div class="flex flex-wrap justify-center gap-4">
                <a href="#openings" class="px-6 py-3 bg-gradient-to-r from-blue-500 to-green-500 text-white font-semibold rounded-lg hover:shadow-xl hover:scale-105 transition-all duration-300">
                    <i class="fas fa-search mr-2"></i>
                    View Openings
                </a>
                <a href="#apply" class="px-6 py-3 border-2 border-blue-500 text-blue-600 dark:text-blue-400 font-semibold rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all duration-300">
                    <i class="fas fa-envelope mr-2"></i>
                    Submit Resume
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-12 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4 md:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
            <div class="text-center">
                <p class="text-2xl md:text-3xl font-bold text-blue-600 dark:text-blue-400">5+</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Open Positions</p>
            </div>
            <div class="text-center">
                <p class="text-2xl md:text-3xl font-bold text-green-600 dark:text-green-400">100%</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Remote Friendly</p>
            </div>
            <div class="text-center">
                <p class="text-2xl md:text-3xl font-bold text-purple-600 dark:text-purple-400">4.8★</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Team Culture</p>
            </div>
            <div class="text-center">
                <p class="text-2xl md:text-3xl font-bold text-orange-600 dark:text-orange-400">10+</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Team Members</p>
            </div>
        </div>
    </div>
</section>

